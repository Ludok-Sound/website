---
// Cada artículo en castellano: una página por fichero de content/articles/es/.
import ArticlePage from '../../components/ArticlePage.astro';
import { articleSlug, getArticles, type Article } from '../../articles';

export async function getStaticPaths() {
  const articles = await getArticles('es');
  return articles.map((entry) => ({ params: { slug: articleSlug(entry) }, props: { entry } }));
}

const { entry } = Astro.props as { entry: Article };
---

<ArticlePage lang="es" entry={entry} />
