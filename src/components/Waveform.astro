---
// La onda del reproductor de la app: barras grises, lo ya escuchado en morado y su reflejo
// apagado debajo. Las alturas no salen de ninguna canción real: dibujan la forma de un tema de
// club (entra, sube, break y drop) con un ruido fijo, para que salga igual en cada build.
const BARS = 72;
const STEP = 4;
const BAR = 2.4;
const BASELINE = 38;
const TOP = 36;
const REFLECTION = 0.3;

function envelope(t: number): number {
  if (t < 0.08) return 0.45;
  if (t < 0.5) return 0.82;
  if (t < 0.6) return 0.4;
  if (t < 0.92) return 0.96;
  return 0.55;
}

const bars = Array.from({ length: BARS }, (_, i) => {
  const t = i / (BARS - 1);
  const noise = Math.abs((Math.sin(i * 12.9898) * 43758.5453) % 1);
  const h = Math.max(0.12, envelope(t) * (0.8 + 0.2 * noise)) * TOP;
  return { x: i * STEP, h };
});

const width = BARS * STEP;
const height = BASELINE + 2 + TOP * REFLECTION;
---

<div class="wave" aria-hidden="true">
  {
    ['base', 'played'].map((layer) => (
      <svg class={layer} viewBox={`0 0 ${width} ${height}`} preserveAspectRatio="none">
        {bars.map(({ x, h }) => (
          <>
            <rect x={x} y={BASELINE - h} width={BAR} height={h} />
            <rect x={x} y={BASELINE + 2} width={BAR} height={h * REFLECTION} opacity="0.4" />
          </>
        ))}
      </svg>
    ))
  }
</div>
